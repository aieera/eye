generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── 1. AdminUser ───────────────────────────────────────────

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("admin")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  playlists Playlist[]

  @@map("admin_users")
}

// ─── 2. Location ────────────────────────────────────────────

model Location {
  id               String  @id @default(uuid())
  name             String
  oracleLocationId String? @unique
  address          String?
  timezone         String  @default("Asia/Dubai")
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  screens       Screen[]
  productPrices ProductPrice[]
  offers        Offer[]
  playlists     Playlist[]

  @@map("locations")
}

// ─── 3. Screen ──────────────────────────────────────────────

model Screen {
  id            String    @id @default(uuid())
  screenName    String
  screenCode    String    @unique
  deviceToken   String    @unique
  deviceSecret  String
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  status        String    @default("offline")
  lastHeartbeat DateTime?
  orientation   String    @default("landscape")
  resolution    String?
  appVersion    String?
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  schedules  Schedule[]
  screenLogs ScreenLog[]

  @@map("screens")
}

// ─── 4. Category ────────────────────────────────────────────

model Category {
  id              String    @id @default(uuid())
  name            String
  oracleDept      String?
  oracleClass     String?
  oracleSubclass  String?
  parentId        String?
  parent          Category? @relation("CategoryParent", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryParent")
  level           String    @default("dept")
  displayOrder    Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  products Product[]

  @@map("categories")
}

// ─── 5. Product ─────────────────────────────────────────────

model Product {
  id                String    @id @default(uuid())
  externalItemCode  String    @unique
  name              String
  shortName         String?
  description       String?   @db.Text
  dept              String?
  classCode         String?
  subclass          String?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  status            String    @default("active")
  hasValidImage     Boolean   @default(false)
  imageUrl          String?
  videoUrl          String?
  fallbackImageUrl  String?
  uom               String?
  isSynced          Boolean   @default(false)
  isActive          Boolean   @default(true)
  oracleSyncedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  prices        ProductPrice[]
  offers        Offer[]
  playlistItems PlaylistItem[]

  @@map("products")
}

// ─── 6. ProductPrice ────────────────────────────────────────

model ProductPrice {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  locationId        String
  location          Location  @relation(fields: [locationId], references: [id])
  unitRetail        Decimal   @db.Decimal(24, 4)
  sellingUnitRetail Decimal?  @db.Decimal(24, 4)
  sellingUom        String?
  currency          String    @default("AED")
  effectiveDate     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([productId, locationId])
  @@map("product_prices")
}

// ─── 7. Offer ───────────────────────────────────────────────

model Offer {
  id                  String    @id @default(uuid())
  name                String
  title               String?
  description         String?   @db.Text
  productId           String?
  product             Product?  @relation(fields: [productId], references: [id])
  locationId          String?
  location            Location? @relation(fields: [locationId], references: [id])
  originalPrice       Decimal?  @db.Decimal(24, 4)
  offerPrice          Decimal?  @db.Decimal(24, 4)
  discountPercentage  Decimal?  @db.Decimal(5, 2)
  imageUrl            String?
  source              String    @default("manual")
  startDate           DateTime
  endDate             DateTime
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  playlistItems PlaylistItem[]

  @@map("offers")
}

// ─── 8. Playlist ────────────────────────────────────────────

model Playlist {
  id                  String    @id @default(uuid())
  name                String
  description         String?   @db.Text
  locationId          String?
  location            Location? @relation(fields: [locationId], references: [id])
  version             Int       @default(1)
  status              String    @default("draft")
  transitionType      String    @default("fade")
  transitionDurationMs Int      @default(500)
  defaultDurationSec  Int       @default(5)
  createdById         String
  createdBy           AdminUser @relation(fields: [createdById], references: [id])
  publishedAt         DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  items     PlaylistItem[]
  schedules Schedule[]

  @@map("playlists")
}

// ─── 9. PlaylistItem ────────────────────────────────────────

model PlaylistItem {
  id                     String    @id @default(uuid())
  playlistId             String
  playlist               Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  itemType               String
  productId              String?
  product                Product?  @relation(fields: [productId], references: [id])
  offerId                String?
  offer                  Offer?    @relation(fields: [offerId], references: [id])
  mediaUrl               String?
  customText             String?   @db.Text
  customStyle            Json?
  displayDurationSeconds Int       @default(10)
  displayOrder           Int
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("playlist_items")
}

// ─── 10. Schedule ───────────────────────────────────────────

model Schedule {
  id              String    @id @default(uuid())
  screenId        String
  screen          Screen    @relation(fields: [screenId], references: [id])
  playlistId      String
  playlist        Playlist  @relation(fields: [playlistId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  startTime       String
  endTime         String
  recurrenceType  String    @default("daily")
  daysOfWeek      Json?
  priority        Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([screenId, startTime, endTime])
  @@map("schedules")
}

// ─── 11. IngestionConnection ────────────────────────────────

model IngestionConnection {
  id                        String    @id @default(uuid())
  name                      String
  connectionType            String    @default("oracle")
  encryptedConnectionConfig String    @db.Text
  isActive                  Boolean   @default(true)
  lastSyncAt                DateTime?
  syncIntervalMinutes       Int       @default(60)
  lastTestedAt              DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  fieldMappings  IngestionFieldMapping[]
  ingestionLogs  IngestionLog[]

  @@map("ingestion_connections")
}

// ─── 12. IngestionFieldMapping ──────────────────────────────

model IngestionFieldMapping {
  id              String @id @default(uuid())
  connectionId    String
  connection      IngestionConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  entityType      String
  externalField   String
  internalField   String
  transformRule   String?
  isRequired      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("ingestion_field_mappings")
}

// ─── 13. IngestionLog ───────────────────────────────────────

model IngestionLog {
  id               String    @id @default(uuid())
  connectionId     String
  connection       IngestionConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncType         String
  status           String
  recordsProcessed Int       @default(0)
  recordsCreated   Int       @default(0)
  recordsUpdated   Int       @default(0)
  recordsFailed    Int       @default(0)
  errorMessage     String?   @db.Text
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@map("ingestion_logs")
}

// ─── 14. ScreenLog ──────────────────────────────────────────

model ScreenLog {
  id        String   @id @default(uuid())
  screenId  String
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  eventType String
  payload   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("screen_logs")
}

// ─── 15. SystemLog ──────────────────────────────────────────

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  module    String
  action    String
  message   String   @db.Text
  metadata  Json?
  userId    String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}
